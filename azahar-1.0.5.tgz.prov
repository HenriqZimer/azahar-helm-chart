Hash: SHA512

annotations:
  artifacthub.io/changes: |
    - kind: fixed
      description: README install commands now use a unique repo alias (<name>-helm-chart) instead of the bare chart name, and pin --version explicitly, matching what actually works
  artifacthub.io/changesHistory: |
    - version: 1.0.4
      changes:
        - kind: changed
          description: README now shows the emulator's logo at the top (linuxserver.io's own image, same one used for the chart icon)
    - version: 1.0.3
      changes:
        - kind: added
          description: Chart releases are now signed (helm package --sign) - see artifacthub.io/signKey for the public key location and fingerprint, powers the "Signed" badge on ArtifactHub
    - version: 1.0.2
      changes:
        - kind: added
          description: values.schema.json - validates values.yaml against a JSON Schema, and is what powers the "Values schema" feature/badge on ArtifactHub (previously absent)
    - version: 1.0.1
      changes:
        - kind: added
          description: icon, previously missing entirely - pointed at linuxserver.io's own logo image for this app, which is why no image was ever showing on ArtifactHub
    - version: 1.0.0
      changes:
        - kind: added
          description: Initial release of the Azahar Helm chart
        - kind: added
          description: GPU passthrough for both Intel/AMD (VA-API via /dev/dri) and NVIDIA (via the NVIDIA Kubernetes device plugin, gpu.vendor=nvidia)
        - kind: added
          description: seccompUnconfined and a 2Gi default shmSize, both carried over from this chart's sibling pcsx2-helm-chart after PCSX2's JIT recompiler was found to crash with SIGBUS under Docker/Kubernetes' default seccomp/shm limits - not independently confirmed on Azahar, but the same base image/toolchain makes it a likely fix if you hit the same crash
        - kind: added
          description: streaming.enabled/streaming.brokerPort in values.yaml, kept only so the chart's shape matches its siblings. WARNING - no RomM broker mod exists for Azahar at all - unlike PCSX2/Dolphin/xemu/Eden/RPCS3/PPSSPP there isn't even a placeholder repo, azahar-romm-integration does not exist anywhere on GitHub - there is nothing to enable yet
  artifacthub.io/license: MIT
  artifacthub.io/links: |
    - name: Helm Repository
      url: https://henriqzimer.github.io/azahar-helm-chart/
